# pi-gen settings for the ChAIpi image (image/build.sh adds FIRST_USER_PASS, and PUBKEY_SSH_FIRST_USER if given).
# SSH is keys-only, but that's set by install.sh: pi-gen's PUBKEY_ONLY_SSH refuses to build without a key inside.
IMG_NAME=chaipi
TARGET_HOSTNAME=chaipi
FIRST_USER_NAME=pi
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=1
LOCALE_DEFAULT=en_GB.UTF-8
TIMEZONE_DEFAULT=Asia/Kolkata
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
WPA_COUNTRY=IN
DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
STAGE_LIST="stage0 stage1 stage2 stage-chaipi"
